<Window x:Class="VoBaMinhKhoiWPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login - Lucy Sales" Height="400" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#f2f2f2">
    <Border Margin="20" Padding="20" Background="White" CornerRadius="10" BorderBrush="#ccc" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Lucy Sales System" FontSize="20" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0 0 0 20"/>

            <StackPanel Margin="0 0 0 10">
                <TextBlock Text="Role" FontWeight="SemiBold"/>
                <ComboBox x:Name="RoleComboBox" Height="30"/>
            </StackPanel>

            <StackPanel Margin="0 0 0 10">
                <TextBlock Text="Username / Phone" FontWeight="SemiBold"/>
                <TextBox x:Name="UsernameTextBox" Height="30" Padding="5" />
            </StackPanel>

            <StackPanel Margin="0 0 0 20">
                <TextBlock Text="Password (Employee only)" FontWeight="SemiBold"/>
                <PasswordBox x:Name="PasswordBox" Height="30" PasswordChanged="PasswordBox_PasswordChanged"/>
            </StackPanel>

            <Button Content="Login" Click="LoginButton_Click"
                    Background="#007ACC" Foreground="White"
                    FontWeight="Bold" Height="35" BorderBrush="{x:Null}" />
        </StackPanel>
    </Border>
</Window>
