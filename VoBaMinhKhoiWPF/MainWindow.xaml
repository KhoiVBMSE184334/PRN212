<Window x:Class="VoBaMinhKhoiWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lucy Sales - Dashboard" Height="500" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <StackPanel Background="#2D2D30" Grid.Column="0">
            <TextBlock Text="Lucy Sales" Foreground="White" FontSize="20" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0 20"/>
            <Button Content="Customers" Name="BtnCustomer" Click="BtnCustomer_Click" Margin="10" />
            <Button Content="Products" Name="BtnProduct" Click="BtnProduct_Click" Margin="10" />
            <Button Content="Orders" Name="BtnOrder" Click="BtnOrder_Click" Margin="10" />
            <Button Content="Categories" Name="BtnCategory" Click="BtnCategory_Click" Margin="10" />
            <Button Content="Reports" Name="BtnReport" Click="BtnReport_Click" Margin="10" />
            <Button Content="Logout" Name="BtnLogout" Click="BtnLogout_Click" Margin="10" Foreground="Red"/>
        </StackPanel>

        <!-- Main content -->
        <ContentControl x:Name="MainContent" Grid.Column="1" Margin="10,10,0,10"/>
    </Grid>
</Window>
